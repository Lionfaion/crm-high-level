// Prisma schema for CRM High Level (GoHighLevel clone)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENCY_USER
  ACCOUNT_ADMIN
  ACCOUNT_USER
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

enum ActivityType {
  NOTE_ADDED
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL_MADE
  CALL_RECEIVED
  MEETING_SCHEDULED
  MEETING_COMPLETED
  STAGE_CHANGED
  OPPORTUNITY_CREATED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  CONTACT_CREATED
  CONTACT_UPDATED
  TASK_CREATED
  TASK_COMPLETED
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

// ─── Agency (top-level tenant) ───────────────────────────────────────────────

model Agency {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  logoUrl     String?
  email       String   @unique
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  zipCode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts Account[]
  users    User[]

  @@map("agencies")
}

// ─── Account (sub-account, e.g. a client business) ──────────────────────────

model Account {
  id          String   @id @default(uuid())
  agencyId    String
  name        String
  email       String
  phone       String?
  website     String?
  logoUrl     String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency        Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users         User[]
  contacts      Contact[]
  pipelines     Pipeline[]
  activities    Activity[]
  settings      AccountSettings?
  conversations Conversation[]
  campaigns     Campaign[]
  chatbotRules  ChatbotRule[]
  chatWidget    ChatWidget?

  @@map("accounts")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  agencyId     String?
  accountId    String?
  email        String   @unique
  name         String
  avatarUrl    String?
  role         UserRole @default(ACCOUNT_USER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency       Agency?       @relation(fields: [agencyId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  notes        Note[]
  activities   Activity[]
  opportunities Opportunity[] @relation("OpportunityOwner")

  @@map("users")
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model Contact {
  id          String        @id @default(uuid())
  accountId   String
  email       String?
  firstName   String
  lastName    String?
  phone       String?
  company     String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  status      ContactStatus @default(LEAD)
  tags        String[]
  customFields Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities     Opportunity[]
  notes             Note[]
  activities        Activity[]
  conversations     Conversation[]
  campaignRecipients CampaignRecipient[]

  @@index([accountId])
  @@index([email])
  @@map("contacts")
}

// ─── Pipeline ────────────────────────────────────────────────────────────────

model Pipeline {
  id        String   @id @default(uuid())
  accountId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stages  Stage[]

  @@index([accountId])
  @@map("pipelines")
}

// ─── Stage ───────────────────────────────────────────────────────────────────

model Stage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  position    Int
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId])
  @@map("stages")
}

// ─── Opportunity ─────────────────────────────────────────────────────────────

model Opportunity {
  id          String            @id @default(uuid())
  contactId   String
  stageId     String
  ownerId     String?
  name        String
  value       Decimal?          @db.Decimal(12, 2)
  status      OpportunityStatus @default(OPEN)
  closeDate   DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage      Stage      @relation(fields: [stageId], references: [id])
  owner      User?      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  noteItems  Note[]
  activities Activity[]

  @@index([contactId])
  @@index([stageId])
  @@map("opportunities")
}

// ─── Note ────────────────────────────────────────────────────────────────────

model Note {
  id            String   @id @default(uuid())
  contactId     String?
  opportunityId String?
  authorId      String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])

  @@index([contactId])
  @@index([opportunityId])
  @@map("notes")
}

// ─── Activity (audit log) ────────────────────────────────────────────────────

model Activity {
  id            String       @id @default(uuid())
  accountId     String
  contactId     String?
  opportunityId String?
  userId        String?
  type          ActivityType
  metadata      Json?
  createdAt     DateTime     @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([contactId])
  @@index([opportunityId])
  @@map("activities")
}

// ─── AccountSettings ──────────────────────────────────────────────────────────

model AccountSettings {
  id                String   @id @default(uuid())
  accountId         String   @unique
  businessName      String?
  supportEmail      String?
  supportPhone      String?
  timezone          String   @default("UTC")
  currency          String   @default("USD")
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#6d28d9")
  secondaryColor    String   @default("#4f46e5")
  // Social links
  facebookUrl       String?
  instagramUrl      String?
  linkedinUrl       String?
  twitterUrl        String?
  // Notifications
  emailNotifications   Boolean @default(true)
  smsNotifications     Boolean @default(false)
  // Address
  address           String?
  city              String?
  state             String?
  country           String?
  zipCode           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

enum Channel {
  EMAIL
  SMS
  CHAT
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Conversation {
  id        String             @id @default(uuid())
  accountId String
  contactId String
  channel   Channel
  status    ConversationStatus @default(OPEN)
  subject   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([accountId])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  body           String
  html           String?
  subject        String?
  fromAddress    String?
  toAddress      String?
  externalId     String?
  sentAt         DateTime         @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum CampaignType {
  EMAIL
  SMS
}

model Campaign {
  id          String         @id @default(uuid())
  accountId   String
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  subject     String?
  body        String
  fromName    String?
  fromEmail   String?
  fromPhone   String?
  tags        String[]
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([accountId])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  contactId  String
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
  @@map("campaign_recipients")
}

// ─── Chatbot Rules ────────────────────────────────────────────────────────────

model ChatbotRule {
  id        String   @id @default(uuid())
  accountId String
  trigger   String
  response  String
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("chatbot_rules")
}

// ─── Chat Widget ──────────────────────────────────────────────────────────────

model ChatWidget {
  id              String   @id @default(uuid())
  accountId       String   @unique
  greeting        String   @default("Hi! How can we help you?")
  primaryColor    String   @default("#6d28d9")
  agentName       String   @default("Support")
  agentAvatarUrl  String?
  isEnabled       Boolean  @default(true)
  allowedDomains  String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("chat_widgets")
}
