# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://crm_user:crm_pass@localhost:5432/crm_highlevel

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_URL=https://your-vercel-app.vercel.app

# ── API URL (for the frontend to call the backend) ──────────────────────────
# Set this to your Railway/Render/Fly.io API URL after deploying the API
NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
